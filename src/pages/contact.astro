---
import Layout from "../layouts/Layout.astro";
import { BAND, SOCIAL_LINKS } from "../data/band";

// Static site, so the form needs an external backend (Formspree, Basin,
// Web3Forms...). Without one configured, only the email addresses show.
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;

const inputClass =
  "w-full border border-line bg-surface px-4 py-3 text-base text-ink focus:border-ink focus:outline-none";
---

<Layout
  title={`Contact | ${BAND.name}`}
  description={`Get in touch with ${BAND.name} for bookings, press and general enquiries.`}
  active="contact"
>
  <section class="mx-auto max-w-[1120px] px-6 pt-16 pb-12">
    <h1 class="m-0 mb-4 font-display text-4xl font-semibold text-ink sm:text-5xl">Contact</h1>
    <p class="m-0 max-w-[640px] text-lg leading-relaxed text-body">
      For bookings, press or anything else, drop us a line.
    </p>
  </section>

  <section class="mx-auto grid max-w-[1120px] gap-12 px-6 pb-20 md:grid-cols-[1fr_1.4fr]">
    <dl class="m-0 space-y-6">
      <div>
        <dt class="mb-1 text-xs font-semibold tracking-widest text-muted uppercase">General</dt>
        <dd class="m-0"><a href={`mailto:${BAND.email}`} class="text-lg">{BAND.email}</a></dd>
      </div>
      <div>
        <dt class="mb-1 text-xs font-semibold tracking-widest text-muted uppercase">Bookings</dt>
        <dd class="m-0"><a href={`mailto:${BAND.bookingEmail}`} class="text-lg">{BAND.bookingEmail}</a></dd>
      </div>
      <div>
        <dt class="mb-1 text-xs font-semibold tracking-widest text-muted uppercase">Based in</dt>
        <dd class="m-0 text-lg text-ink">{BAND.location}</dd>
      </div>
      {SOCIAL_LINKS.length > 0 && (
        <div>
          <dt class="mb-1 text-xs font-semibold tracking-widest text-muted uppercase">Follow</dt>
          <dd class="m-0 flex flex-wrap gap-4">
            {SOCIAL_LINKS.map((link) => <a href={link.href} rel="noopener">{link.label}</a>)}
          </dd>
        </div>
      )}
    </dl>

    {formEndpoint && (
      <form action={formEndpoint} method="POST" class="space-y-5 border border-line bg-surface p-6 sm:p-8">
        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium text-ink">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" class={inputClass} />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-ink">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class={inputClass} />
        </div>
        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-ink">Message</label>
          <textarea id="message" name="message" rows="6" required class={inputClass}></textarea>
        </div>
        <button type="submit" class="bg-ink px-6 py-3 text-sm font-medium text-page hover:bg-accent-hover">
          Send message
        </button>
      </form>
    )}
  </section>
</Layout>
