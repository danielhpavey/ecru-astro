---
import type { GetStaticPathsOptions, Page } from "astro";
import { sanityClient } from "../../sanity/client";
import { CATEGORIES_QUERY, POSTS_LIST_QUERY } from "../../sanity/queries";
import Layout from "../../layouts/Layout.astro";
import PostGrid from "../../components/PostGrid.astro";
import Pagination from "../../components/Pagination.astro";
import CategoryLinks from "../../components/CategoryLinks.astro";
import type { Category, PostSummary } from "../../sanity/types";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const PAGE_SIZE = 9;
  const posts: PostSummary[] = sanityClient ? await sanityClient.fetch(POSTS_LIST_QUERY) : [];
  return paginate(posts, { pageSize: PAGE_SIZE });
}

interface Props {
  page: Page<PostSummary>;
}

const { page } = Astro.props;
const categories: Category[] = sanityClient ? await sanityClient.fetch(CATEGORIES_QUERY) : [];
---

<Layout
  title="Blog | The Ecru Stretch"
  description="News, gig announcements and updates from The Ecru Stretch."
  active="blog"
>
  <section class="mx-auto max-w-[1120px] px-6 pt-16 pb-12">
    <h1 class="m-0 mb-4 font-display text-4xl font-semibold text-ink sm:text-5xl">Blog</h1>
    <p class="m-0 mb-6 text-lg leading-relaxed text-body">
      News, gig announcements and updates from the band.
    </p>
    <CategoryLinks categories={categories} />
  </section>

  {/* Hidden section heading so the outline runs h1 → h2 → h3 (card titles). */}
  <h2 class="sr-only">All posts</h2>
  <PostGrid
    posts={page.data}
    padBottom={page.lastPage <= 1}
    emptyMessage={sanityClient
      ? "No posts published yet. Check back soon."
      : "Blog isn't connected yet: set PUBLIC_SANITY_PROJECT_ID to enable it."}
  />

  <Pagination page={page} basePath="/blog" />
</Layout>
