---
import { PortableText } from "astro-portabletext";
import Layout from "../../layouts/Layout.astro";
import PortableTextImage from "../../components/PortableTextImage.astro";
import { urlFor, buildSrcSet } from "../../sanity/imageUrl";
import { sanityClient } from "../../sanity/client";
import { POST_DETAIL_QUERY } from "../../sanity/queries";
import type { Post } from "../../sanity/types";

export async function getStaticPaths() {
  if (!sanityClient) return [];

  const posts: Post[] = await sanityClient.fetch(POST_DETAIL_QUERY);

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

const HEADER_ASPECT_RATIO = 1600 / 900;
const HEADER_WIDTHS = [640, 960, 1280, 1600, 2000];

const imageUrl = post.mainImage
  ? urlFor(post.mainImage).width(1600).height(900).fit("crop").auto("format").url()
  : null;
const imageSrcSet = post.mainImage
  ? buildSrcSet(post.mainImage, HEADER_WIDTHS, { aspectRatio: HEADER_ASPECT_RATIO })
  : null;

const formattedDate = new Date(post.publishedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const portableTextComponents = {
  type: {
    image: PortableTextImage,
  },
};

const canonicalURL = new URL(`/blog/${post.slug}/`, Astro.site).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt ?? post.title,
  datePublished: post.publishedAt,
  ...(imageUrl && { image: imageUrl }),
  ...(post.authorName && { author: { "@type": "Person", name: post.authorName } }),
  mainEntityOfPage: canonicalURL,
  publisher: {
    "@type": "MusicGroup",
    name: "The Ecru Stretch",
  },
};
---

<Layout
  title={`${post.title} | The Ecru Stretch`}
  description={post.excerpt ?? post.title}
  active="blog"
  image={imageUrl ?? undefined}
  type="article"
  publishedTime={post.publishedAt}
  author={post.authorName}
  structuredData={structuredData}
>
  <article class="mx-auto max-w-[720px] px-6 pt-16 pb-20">
    <a href="/blog" class="mb-8 inline-block text-sm text-muted hover:text-ink">&larr; All posts</a>
    <h1 class="m-0 mb-4 font-display text-4xl font-semibold text-ink sm:text-5xl">{post.title}</h1>
    <div class="mb-10 flex items-center gap-2 text-sm text-muted">
      {post.authorName && <span>{post.authorName}</span>}
      {post.authorName && <span>&middot;</span>}
      <time datetime={post.publishedAt}>{formattedDate}</time>
    </div>

    {imageUrl && (
      <img
        src={imageUrl}
        srcset={imageSrcSet}
        sizes="(min-width: 720px) 720px, 100vw"
        width="1600"
        height="900"
        alt={post.mainImage?.alt ?? ""}
        class="mb-10 block w-full"
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class="text-body [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-ink [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-ink [&_p]:mb-5 [&_p]:text-[17px] [&_p]:leading-relaxed [&_a]:underline [&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_blockquote]:border-l-2 [&_blockquote]:border-ink [&_blockquote]:pl-4 [&_blockquote]:italic">
      <PortableText value={post.body} components={portableTextComponents} />
    </div>
  </article>
</Layout>
