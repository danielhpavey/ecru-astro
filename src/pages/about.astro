---
import Layout from "../layouts/Layout.astro";
import { BAND, MEMBERS } from "../data/band";

// Each member card gets a colour from the logo, cycling through the set.
const MEMBER_COLOURS = [
  "bg-teal-dark text-white",
  "bg-magenta text-white",
  "bg-amber text-ink",
  "bg-purple text-white",
];

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<Layout
  title={`About | ${BAND.name}`}
  description={`Who we are: the story and line-up of ${BAND.name}.`}
  active="about"
>
  <section class="mx-auto max-w-[1120px] px-6 pt-12 pb-10">
    <h1 class="squiggle m-0 mb-6 font-display text-4xl font-extrabold text-ink sm:text-5xl">About us</h1>
    <p class="m-0 max-w-[640px] text-lg font-semibold leading-relaxed text-body">{BAND.shortBio}</p>
  </section>

  <section class="mx-auto grid max-w-[1120px] gap-12 px-6 pb-20 md:grid-cols-[1.3fr_1fr]">
    <div class="scroll-reveal space-y-5 text-base leading-relaxed text-body">
      <h2 class="m-0 pb-3 font-display text-2xl font-extrabold text-ink" style="--squiggle: var(--color-teal)">
        <span class="squiggle">Our story</span>
      </h2>
      <p>
        Placeholder — how the band got together, where you're from, and what you've been up to.
        A few short paragraphs works well here.
      </p>
      <p>
        Placeholder — influences, the sound you're going for, releases and notable gigs.
      </p>
      <p>
        Placeholder — what's coming next: new music, upcoming shows, anything you want people to
        know about.
      </p>
    </div>

    <div class="scroll-reveal">
      <h2 class="m-0 mb-6 font-display text-2xl font-extrabold text-ink" style="--squiggle: var(--color-magenta)">
        <span class="squiggle">The band</span>
      </h2>
      <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        {MEMBERS.map((member, i) => (
          <li class:list={["sticker flex items-center gap-4 bg-surface p-4", i % 2 ? "rotate-1" : "-rotate-1"]}>
            <span
              class:list={[
                "flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-2 border-ink text-sm font-extrabold",
                MEMBER_COLOURS[i % MEMBER_COLOURS.length],
              ]}
              aria-hidden="true"
            >
              {initials(member.name)}
            </span>
            <span class="flex flex-col">
              <span class="font-extrabold text-ink">{member.name}</span>
              <span class="text-sm font-semibold text-muted">{member.role}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
