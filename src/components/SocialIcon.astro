---
// Simple 24×24 icons for the social links in src/data/band.ts, matched by
// label. They use currentColor, so they follow the surrounding text colour.
// Unknown labels fall back to a generic link icon.

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "h-5 w-5" } = Astro.props;
const key = name.toLowerCase();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {key === "instagram" ? (
    <g fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
    </g>
  ) : key === "youtube" ? (
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M2 8.5A3.5 3.5 0 0 1 5.5 5h13A3.5 3.5 0 0 1 22 8.5v7a3.5 3.5 0 0 1-3.5 3.5h-13A3.5 3.5 0 0 1 2 15.5v-7ZM10 9v6l5-3-5-3Z"
    />
  ) : key === "spotify" ? (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="10" />
      <path d="M7 9.5c3.4-1 7-.7 10 1" />
      <path d="M7.5 12.7c2.9-.8 5.8-.5 8.3.9" />
      <path d="M8 15.7c2.3-.6 4.5-.4 6.5.7" />
    </g>
  ) : key === "bandcamp" ? (
    <path fill="currentColor" d="M8.5 6.5H22l-6.5 11H2l6.5-11Z" />
  ) : key === "facebook" ? (
    <path
      fill="currentColor"
      d="M13.5 21v-7.5H16l.5-3h-3V8.6c0-.9.3-1.6 1.6-1.6h1.5V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.4H8v3h2.5V21h3Z"
    />
  ) : key === "tiktok" ? (
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M15 2.5v12a4.5 4.5 0 1 1-4.5-4.5M15 2.5c.4 2.9 2.5 5 5.5 5.3"
    />
  ) : (
    <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" />
      <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
    </g>
  )}
</svg>
