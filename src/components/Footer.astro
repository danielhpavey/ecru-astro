---
import { BAND, SOCIAL_LINKS } from "../data/band";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto flex max-w-[1120px] flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="font-display text-lg font-semibold text-ink">{BAND.name}</div>
      <a href={`mailto:${BAND.email}`} class="text-sm text-muted hover:text-ink">{BAND.email}</a>
    </div>
    {SOCIAL_LINKS.length > 0 && (
      <nav aria-label="Social links" class="flex flex-wrap gap-5">
        {SOCIAL_LINKS.map((link) => (
          <a href={link.href} class="text-sm text-muted hover:text-ink" rel="noopener">{link.label}</a>
        ))}
      </nav>
    )}
  </div>
  <div class="border-t border-line py-5 text-xs text-muted">
    <div class="mx-auto max-w-[1120px] px-6">&copy; {year} {BAND.name}</div>
  </div>
</footer>
