---
import { BAND, SOCIAL_LINKS } from "../data/band";

const year = new Date().getFullYear();
---

<footer class="bg-ink text-cream">
  <div class="rainbow-stripe"></div>
  <div class="mx-auto flex max-w-[1120px] flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="font-display text-xl font-extrabold">{BAND.name}</div>
      <a href={`mailto:${BAND.email}`} class="text-sm text-cream/80 hover:text-amber">{BAND.email}</a>
    </div>
    {SOCIAL_LINKS.length > 0 && (
      <nav aria-label="Social links" class="flex flex-wrap gap-3">
        {SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            rel="noopener"
            class="rounded-full border-2 border-cream/60 px-4 py-1.5 text-sm font-bold text-cream no-underline hover:border-amber hover:text-amber"
          >
            {link.label}
          </a>
        ))}
      </nav>
    )}
  </div>
  <div class="border-t border-cream/15 py-5 text-xs text-cream/70">
    <div class="mx-auto max-w-[1120px] px-6">&copy; {year} {BAND.name}. Turn it up.</div>
  </div>
</footer>
