---
import type { Page } from "astro";

interface Props {
  page: Page<unknown>;
  basePath: string;
}

const { page, basePath } = Astro.props;

// Page 1 lives at basePath itself (e.g. /blog), later pages get a segment
// appended (e.g. /blog/2) — matches the [...page].astro rest-param routing.
const hrefFor = (n: number) => (n === 1 ? basePath : `${basePath}/${n}`);
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

{page.lastPage > 1 && (
  <div class="mx-auto max-w-[1120px] px-6 pb-20">
    <nav aria-label="Blog pagination" class="flex flex-wrap items-center justify-center gap-2">
      {page.url.prev ? (
        <a
          href={hrefFor(page.currentPage - 1)}
          class="rounded-full border-2 border-ink px-4 py-2 text-sm font-bold text-ink no-underline transition-colors hover:bg-cream hover:text-ink"
        >
          Previous
        </a>
      ) : (
        <span class="rounded-full border-2 border-line px-4 py-2 text-sm font-bold text-muted opacity-60">
          Previous
        </span>
      )}

      {pageNumbers.map((n) => (
        <a
          href={hrefFor(n)}
          aria-current={n === page.currentPage ? "page" : undefined}
          class:list={[
            "rounded-full border-2 border-ink px-4 py-2 text-sm font-bold no-underline transition-colors",
            n === page.currentPage
              ? "bg-magenta text-white hover:text-white"
              : "text-ink hover:bg-cream hover:text-ink",
          ]}
        >
          {n}
        </a>
      ))}

      {page.url.next ? (
        <a
          href={hrefFor(page.currentPage + 1)}
          class="rounded-full border-2 border-ink px-4 py-2 text-sm font-bold text-ink no-underline transition-colors hover:bg-cream hover:text-ink"
        >
          Next
        </a>
      ) : (
        <span class="rounded-full border-2 border-line px-4 py-2 text-sm font-bold text-muted opacity-60">
          Next
        </span>
      )}
    </nav>
  </div>
)}
