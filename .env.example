# Copy this file to .env and fill in your Sanity project's details.
# Get these from https://sanity.io/manage after running `npx sanity login`.

PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional: a form backend URL (e.g. Formspree, Basin, Web3Forms) for the
# contact page. Leave empty to show the email address only.
PUBLIC_CONTACT_FORM_ENDPOINT=
